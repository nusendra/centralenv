# --- Required ---
# Generate with: openssl rand -base64 32
MASTER_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Web runtime ---
# Browser-visible URL of the server when web and server live on different domains.
# Example: https://api.centralenv.example.com
# Leave blank for single-domain / reverse-proxy setups.
# Read at runtime — no rebuild needed when this changes.
PUBLIC_API_URL=

# --- Image overrides (optional) ---
# Pin to a specific image tag instead of :latest
# SERVER_IMAGE=ghcr.io/nusendra/centralenv-server:v0.1.0
# WEB_IMAGE=ghcr.io/nusendra/centralenv-web:v0.1.0

# --- Optional port overrides (host side) ---
SERVER_PORT=3001
WEB_PORT=3002

# --- Optional ---
RUST_LOG=centralenv_server=info,tower_http=info
